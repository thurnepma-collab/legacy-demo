---
import { u } from "../lib/url";
import Base from '../layouts/Base.astro';
---
<Base title="Patrocinios y contacto" description="Patrocina Legacy Fight League: eventos, jaula, transmisión y peleadores. Contacto de prensa y prensa acreditada.">
  <div class="eyebrow">Marcas y prensa</div>
  <h1>Patrocinios</h1>
  <div class="grid grid-2" style="margin-top:24px">
    <div class="card box">
      <h3>Para marcas</h3>
      <p class="muted">Presencia en jaula, transmisión en YouTube, activaciones en el venue y peleadores embajadores. Solicita el media kit con audiencia por evento.</p>
      <a class="btn" href="mailto:contacto@riotfl.mx?subject=Patrocinio%20Legacy%20Fight%20League">Solicitar media kit</a>
    </div>
    <div class="card box">
      <h3>Para prensa</h3>
      <p class="muted">Acreditación por evento, acceso a pesaje y zona mixta. Resultados oficiales publicados la misma noche en este sitio.</p>
      <a class="btn btn-ghost" href="mailto:contacto@riotfl.mx?subject=Acreditaci%C3%B3n%20de%20prensa">Acreditarse</a>
    </div>
  </div>
  <p class="muted" style="margin-top:28px">WhatsApp: <a href="https://wa.me/5518286570" style="text-decoration:underline">55 1828 6570</a> · contacto@riotfl.mx</p>
</Base>
<style>.box { padding: 26px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }</style>
