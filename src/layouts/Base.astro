---
import { u } from "../lib/url";
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-700.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;      // ruta relativa, p.ej. /og/peleadores/roberto-zambrano.png
  ogType?: 'website' | 'profile' | 'article';
}
const { title, description, ogImage = '/og/default.jpg', ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogAbs = new URL(u(ogImage), Astro.site);
const fullTitle = title === 'Legacy Fight League' ? title : `${title} | Legacy Fight League`;
const nav = [
  { href: u('/eventos'), label: 'Eventos' },
  { href: u('/peleadores'), label: 'Peleadores' },
  { href: u('/rankings'), label: 'Rankings' },
  { href: u('/contacto'), label: 'Patrocinios' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0d" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Legacy Fight League" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@riotfightleague" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={u('/')}><img src={u('/legacy-logo.png')} alt="Legacy Fight League" width="1080" height="298" /></a>
      <div class="top-right">
        <a class="btn btn-sm" href="https://ticketwolf.mx/e/legacy-19" target="_blank" rel="noopener">Boletos</a>
        <button class="burger" id="burger" type="button" aria-label="Abrir menú" aria-controls="nav" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
      <nav id="nav">
        {nav.map((n) => <a href={n.href} class:list={{ active: path.startsWith(n.href) }}>{n.label}</a>)}
      </nav>
    </header>
    <script>
      const b = document.getElementById('burger');
      const nav = document.getElementById('nav');
      b?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        b.setAttribute('aria-expanded', String(open));
        b.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });
      nav?.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') document.body.classList.remove('nav-open'); });
    </script>
    <main><slot /></main>
    <footer>
      <div>
        <strong>Legacy Fight League</strong> SAPI de CV · Norte 9 101, Moctezuma 2da Sección, Venustiano Carranza, CDMX
      </div>
      <div class="social">
        <a href="https://www.instagram.com/riotfightleague/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.youtube.com/@riotfightleague-i3g" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.facebook.com/profile.php?id=100083081633359" target="_blank" rel="noopener">Facebook</a>
        <a href="mailto:contacto@riotfl.mx">contacto@riotfl.mx</a>
      </div>
      <div class="demo-note">Demo · datos y fotos: Tapology, riotfl.mx · las fotos finales las entrega la liga</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0b0d;
    --bg-2: #141418;
    --bg-3: #1d1d23;
    --line: #2a2a32;
    --text: #f2f2f2;
    --muted: #9a9aa6;
    --red: #e3202b;
    --red-2: #ff3b47;
    --gold: #e8c26a;
    --win: #2fbf71;
    --loss: #e3202b;
    --display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    --body: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--text); font-family: var(--body); -webkit-font-smoothing: antialiased; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; width: 100%; max-width: 1120px; margin: 0 auto; padding: 24px 20px 64px; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, .display { font-family: var(--display); font-weight: 400; letter-spacing: 0.02em; line-height: 0.95; margin: 0; text-transform: uppercase; }
  h1 { font-size: clamp(44px, 8vw, 96px); }
  h2 { font-size: clamp(28px, 4vw, 40px); }
  h3 { font-size: 22px; }
  p { line-height: 1.55; }
  .muted { color: var(--muted); }
  .red { color: var(--red-2); }
  .gold { color: var(--gold); }
  .eyebrow { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red-2); font-weight: 700; }
  .btn { display: inline-flex; align-items: center; gap: 8px; background: var(--red); color: #fff; padding: 14px 22px; border-radius: 6px; font-weight: 700; font-size: 15px; letter-spacing: 0.02em; }
  .btn:hover { background: var(--red-2); }
  .btn-sm { padding: 9px 14px; font-size: 13px; }
  .btn-ghost { background: transparent; border: 1px solid var(--line); }
  .btn-ghost:hover { background: var(--bg-3); }
  .card { background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; }
  .tag { display: inline-block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 8px; border-radius: 4px; background: var(--bg-3); color: var(--muted); font-weight: 700; }
  .tag-red { background: rgba(227,32,43,.15); color: var(--red-2); }
  .tag-gold { background: rgba(232,194,106,.15); color: var(--gold); }
  .grid { display: grid; gap: 16px; }
  .grid-3 { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .grid-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .section { margin-top: 56px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 18px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .section-head a { font-size: 13px; color: var(--muted); font-weight: 700; }

  header.top { display: flex; align-items: center; gap: 24px; padding: 12px 20px; border-bottom: 1px solid var(--line); background: rgba(11,11,13,.85); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 10; }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand img { height: 34px; width: auto; display: block; }
  header nav { display: flex; align-items: center; gap: 22px; flex: 1; justify-content: flex-end; }
  header nav a { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 6px 0; }
  header nav a.active, header nav a:hover { color: var(--text); }
  .top-right { display: flex; align-items: center; gap: 10px; order: 3; }
  .burger { display: none; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 6px; background: transparent; cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
  .burger span { display: block; width: 20px; height: 2px; background: var(--text); transition: transform .2s, opacity .2s; }
  @media (max-width: 760px) {
    header.top { flex-wrap: wrap; gap: 12px; justify-content: space-between; }
    .brand img { height: 28px; }
    .burger { display: flex; }
    header nav { display: none; order: 4; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-top: 8px; border-top: 1px solid var(--line); }
    header nav a { font-size: 16px; padding: 14px 4px; border-bottom: 1px solid var(--line); }
    header nav a:last-child { border-bottom: 0; }
    body.nav-open header nav { display: flex; }
    body.nav-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    body.nav-open .burger span:nth-child(2) { opacity: 0; }
    body.nav-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }

  footer { border-top: 1px solid var(--line); padding: 28px 20px; font-size: 13px; color: var(--muted); display: grid; gap: 10px; }
  footer .social { display: flex; gap: 16px; flex-wrap: wrap; }
  footer .social a:hover { color: var(--text); }
  footer .demo-note { font-size: 11px; opacity: .6; }

  table { width: 100%; border-collapse: collapse; }
  .table-wrap { overflow-x: auto; }
</style>
