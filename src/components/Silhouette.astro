---
// Placeholder de foto de peleador. Sustituir por <img> con la foto real (CMS) sin tocar el layout.
interface Props { seed?: string; class?: string; }
const { seed = 'x', class: cls = '' } = Astro.props;
let h = 0; for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const hue = 350 + (h % 20) - 10;
const id = `g${h.toString(36)}`;
---
<svg class={`silhouette ${cls}`} viewBox="0 0 400 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Foto del peleador (placeholder)">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={`hsl(${hue} 70% 22%)`} />
      <stop offset="1" stop-color="#0b0b0d" />
    </linearGradient>
    <linearGradient id={`${id}-body`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2a33" />
      <stop offset="1" stop-color="#101014" />
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="50%" cy="35%" r="55%">
      <stop offset="0" stop-color={`hsl(${hue} 90% 55%)`} stop-opacity=".55" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="400" height="520" fill={`url(#${id}-bg)`} />
  <rect width="400" height="520" fill={`url(#${id}-glow)`} />
  <g fill={`url(#${id}-body)`}>
    <ellipse cx="200" cy="150" rx="52" ry="62" />
    <path d="M110 520 L120 300 Q125 235 200 225 Q275 235 280 300 L290 520 Z" />
    <path d="M122 300 Q70 330 60 420 L95 440 Q110 380 130 340 Z" />
    <path d="M278 300 Q330 330 340 420 L305 440 Q290 380 270 340 Z" />
  </g>
  <rect x="0" y="470" width="400" height="50" fill="#0b0b0d" opacity=".6" />
</svg>
<style>
  .silhouette { display: block; width: 100%; height: auto; }
</style>
